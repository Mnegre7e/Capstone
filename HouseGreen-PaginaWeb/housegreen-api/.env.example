# Copia este archivo como .env y completa tus valores (el .env NO se sube al repositorio)

# Cadena de conexión de la base en Neon (Console -> Connection string)
DATABASE_URL_NEON=postgresql://usuario:clave@servidor.neon.tech/neondb?sslmode=require

# Clave para firmar las sesiones: cualquier texto largo y aleatorio
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# Cuenta de Cloudinary, donde se guardan las fotos de las propiedades
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Llave para cifrar las claves de dos pasos (2FA). La misma en todos los computadores del equipo.
# Se genera con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TWO_FA_KEY=

# Gmail del proyecto para enviar correos (anuncios, recuperar contraseña).
# La clave es la "contraseña de aplicación" de Google (16 caracteres), NO la contraseña del Gmail.
# Si se dejan vacías, los correos no se envían: solo se muestran en la terminal de la API.
CORREO_USUARIO=
CORREO_CLAVE=

# Paso 122d: pagos con Webpay (Transbank). Para las pruebas NO hace falta nada: si se dejan así,
# se usa el ambiente de integración de Transbank (tarjetas de prueba, sin dinero real).
# Solo para cobrar de verdad (con contrato con Transbank y la web publicada con HTTPS):
# WEBPAY_AMBIENTE=produccion
# WEBPAY_CODIGO_COMERCIO=
# WEBPAY_LLAVE_SECRETA=
# Dirección pública de la API (a donde vuelve Webpay) y de la web. Por defecto, las de este PC.
# API_URL=http://localhost:8000
# WEB_URL=http://localhost:5173

# Paso 126: rama "pruebas" de Neon, solo para las pruebas automáticas (pytest). NUNCA la base real.
# Neon -> Connect -> elegir la rama "pruebas" -> Connection string
DATABASE_URL_PRUEBAS=