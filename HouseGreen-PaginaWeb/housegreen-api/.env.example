# Copia este archivo como .env y completa tus valores (el .env NO se sube al repositorio)

# Cadena de conexión de la base en Neon (Console -> Connection string)
DATABASE_URL_NEON=postgresql://usuario:clave@servidor.neon.tech/neondb?sslmode=require

# Clave para firmar las sesiones: cualquier texto largo y aleatorio
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# Cuenta de Cloudinary, donde se guardan las fotos de las propiedades
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Llave para cifrar las claves de dos pasos (2FA). La misma en todos los computadores del equipo.
# Se genera con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TWO_FA_KEY=

# Gmail del proyecto para enviar correos (anuncios, recuperar contraseña).
# La clave es la "contraseña de aplicación" de Google (16 caracteres), NO la contraseña del Gmail.
# Si se dejan vacías, los correos no se envían: solo se muestran en la terminal de la API.
CORREO_USUARIO=
CORREO_CLAVE=

# Paso A22: solo en Render (allí Gmail directo está bloqueado). Los correos salen por el script de Google
# del Gmail del proyecto (correo-google/Codigo.gs). En los computadores del equipo se dejan vacías.
# CORREO_PUENTE_URL=https://script.google.com/macros/s/.../exec
# CORREO_PUENTE_CLAVE=

# Paso 122d: pagos con Webpay (Transbank). Para las pruebas NO hace falta nada: si se dejan así,
# se usa el ambiente de integración de Transbank (tarjetas de prueba, sin dinero real).
# Solo para cobrar de verdad (con contrato con Transbank y la web publicada con HTTPS):
# WEBPAY_AMBIENTE=produccion
# WEBPAY_CODIGO_COMERCIO=
# WEBPAY_LLAVE_SECRETA=
# Dirección pública de la API (a donde vuelve Webpay) y de la web. Por defecto, las de este PC.
# API_URL=http://localhost:8000
# WEB_URL=http://localhost:5173
# Paso A22: otras páginas que pueden llamar a la API (separadas por coma). WEB_URL ya queda permitida.
# ORIGENES_EXTRA=
# Paso A4: dirección de la app HouseGreenM (a donde vuelve la persona si pagó desde la app)
# APP_URL=http://localhost:4200

# Paso 126: rama "pruebas" de Neon, solo para las pruebas automáticas (pytest). NUNCA la base real.
# Neon -> Connect -> elegir la rama "pruebas" -> Connection string
DATABASE_URL_PRUEBAS=

# Pasos 135 a 135d: clave de Google para el NAVEGADOR: vista de calle o mapa en la ficha (Maps Embed API: gratis y sin
# límite) e imagen de la calle en las tarjetas (Street View Static API). Se crea en Google Cloud (Claves y credenciales)
# y se restringe a "Maps Embed API" + "Street View Static API" y a las direcciones de la web y de la app.
# Si se deja vacía, la ficha muestra la foto de siempre (todo lo demás funciona igual).
GOOGLE_MAPS_EMBED_KEY=

# Paso 135d: clave SOLO del servidor, para buscar la foto de calle más cercana a cada remate (búsqueda gratis de
# Google, "Street View Static API" metadata). Se restringe a "Street View Static API" y nunca va en la página.
# La clave de arriba también necesita "Street View Static API" para las imágenes del catálogo, que son gratis
# hasta 10.000 al mes: en Google Cloud se pone un tope de 300 por día para no pasarse nunca.
# Si se deja vacía, la ficha funciona como en el paso 135c (vista de calle solo con calle y número; si no, mapa).
GOOGLE_MAPS_SERVER_KEY=
